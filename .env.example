# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible endpoint instead of real OpenAI
# (e.g. Google Gemini's free tier). Leave empty/unset to use OpenAI directly.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
